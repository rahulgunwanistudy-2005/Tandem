# Copy to .env.local. With no VITE_FIREBASE_PROJECT_ID the console runs against the local
# emulators (project demo-tandem): `pnpm exec firebase emulators:start --project demo-tandem`.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# App Check (enforced for AI Logic since Nov 2, 2026). Site key of a reCAPTCHA Enterprise key.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Local development only: a debug token registered in Console → App Check → Manage debug tokens.
VITE_APPCHECK_DEBUG_TOKEN=
# Force the emulators even when a project is configured.
VITE_USE_EMULATORS=
