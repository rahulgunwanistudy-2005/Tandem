{
  "name": "tandem",
  "private": true,
  "description": "Test prompts on real on-device models, judge and repair with a cloud model, publish per-model routing through Remote Config.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.22.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** --filter ./apps/** build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  }
}
