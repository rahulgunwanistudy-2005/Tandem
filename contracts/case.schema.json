{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tandem.dev/contracts/case.schema.json",
  "title": "Case",
  "type": "object",
  "required": ["id", "input", "asserts", "split", "tags"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "input": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "imagePath": { "type": "string" }
      }
    },
    "asserts": { "type": "array", "items": { "$ref": "#/$defs/assert" }, "maxItems": 20 },
    "rubric": { "type": "string", "maxLength": 2000 },
    "split": { "$ref": "common.schema.json#/$defs/split" },
    "tags": { "type": "array", "items": { "type": "string", "maxLength": 40 }, "maxItems": 10 }
  },
  "$defs": {
    "path": {
      "description": "Dot path into the parsed output, e.g. intent, items[0].sku. Empty string = the whole output.",
      "type": "string",
      "maxLength": 200
    },
    "assert": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "path", "value"],
          "properties": { "kind": { "const": "equals" }, "path": { "$ref": "#/$defs/path" },
            "value": { "type": ["string", "number", "boolean", "null"] } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "path", "values"],
          "properties": { "kind": { "const": "one_of" }, "path": { "$ref": "#/$defs/path" },
            "values": { "type": "array", "minItems": 1, "items": { "type": ["string", "number", "boolean", "null"] } } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "path"],
          "properties": { "kind": { "const": "not_null" }, "path": { "$ref": "#/$defs/path" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "path", "pattern"],
          "properties": { "kind": { "const": "regex" }, "path": { "$ref": "#/$defs/path" },
            "pattern": { "type": "string", "maxLength": 500 }, "flags": { "type": "string", "pattern": "^[imsu]*$" },
            "negate": { "type": "boolean" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "path"],
          "properties": { "kind": { "const": "length" }, "path": { "$ref": "#/$defs/path" },
            "min": { "type": "integer", "minimum": 0 }, "max": { "type": "integer", "minimum": 0 },
            "unit": { "enum": ["chars", "words"] } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "path", "substring"],
          "properties": { "kind": { "const": "contains" }, "path": { "$ref": "#/$defs/path" },
            "substring": { "type": "string", "minLength": 1 }, "caseSensitive": { "type": "boolean" },
            "negate": { "type": "boolean" } }
        }
      ]
    }
  }
}
