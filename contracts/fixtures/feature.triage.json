{
  "id": "triage",
  "name": "Triage",
  "description": "Classify an inbound support message.",
  "outputKind": "json",
  "outputSchema": {
    "type": "object",
    "properties": {
      "intent": {
        "type": "string",
        "enum": [
          "order_status",
          "return_refund",
          "damaged_item",
          "billing",
          "shipping_change",
          "product_question",
          "cancellation",
          "other"
        ]
      },
      "urgency": {
        "type": "string",
        "enum": [
          "low",
          "normal",
          "high"
        ]
      },
      "orderId": {
        "type": "string",
        "nullable": true
      },
      "language": {
        "type": "string",
        "enum": [
          "en",
          "es",
          "fr",
          "de",
          "hi",
          "pt",
          "other"
        ]
      }
    },
    "required": [
      "intent",
      "urgency",
      "orderId",
      "language"
    ]
  },
  "genConfig": {
    "temperature": 0.2,
    "maxOutputTokens": 128
  },
  "latencyBudgetMs": 4000,
  "cloudModel": "gemini-3.5-flash-lite",
  "defaultVariantId": "v1"
}
